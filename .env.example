# ============================================================================
# TrinityCore 3.4.3 Docker — configuration
#   cp .env.example .env   then edit the values below
# ============================================================================

# MySQL root password (used by the DB container AND by the servers).
# CHANGE THIS.
MYSQL_ROOT_PASSWORD=wow

# The Docker image your compose stack runs.
# Default = a LOCAL image name: `docker compose up` builds it from this repo,
# so nothing has to be downloaded and no registry access is needed.
SERVER_IMAGE=trinitycore-3.4.3:local
# To use the daily GitHub Actions build instead, replace the line above with
# your own GHCR path (owner/repo lower-cased) and make that package public:
#   SERVER_IMAGE=ghcr.io/your-github-username/your-repo:latest

# Automatically download the official TrinityCore TDB 3.4.3 world DB on
# first boot (true/false). Set false if you import your own world dump
# through ./import/world/.
AUTO_DOWNLOAD_DB=true

# Realm entry written to auth.realmlist on boot.
#   LAN/friends:  your LAN IP or 127.0.0.1
#   Public host:  your public IP / domain
REALM_NAME=TrinityCore 3.4.3
REALM_ADDRESS=127.0.0.1

# Timezone for container logs (the CI date tag is UTC)
TZ=Europe/Kiev

# ============================================================================
# TrinityCore 3.4.3 Docker — configuration
#   cp .env.example .env   then edit the values below
# ============================================================================

# MySQL root password (used by the DB container AND by the servers).
# CHANGE THIS.
MYSQL_ROOT_PASSWORD=wow

# The Docker image your compose stack runs.
# Default = the PUBLIC image this repo's Actions workflow builds and pushes,
# so `docker compose up -d` downloads a ready server and starts — no
# `docker login`, no compiling. Leave this line alone to keep that behaviour.
SERVER_IMAGE=ghcr.io/kasperfriend/wotlkclassic-trinity-docker:latest

# Whether/how Compose may pull SERVER_IMAGE from a registry:
#   missing (default) keep the cached image, pull only when it isn't cached
#                     yet — `docker compose pull` is how you refresh to the
#                     newest CI build
#   always  pull on every `docker compose up`
#   never   never contact a registry, build from this Dockerfile instead —
#           required pairing for a local-only name like trinitycore-3.4.3:local,
#           because a plain name would otherwise be looked up on Docker Hub and
#           answer "pull access denied …, repository does not exist or may
#           require 'docker login'"
SERVER_PULL_POLICY=missing

# Compile it yourself instead of pulling (25-45 min the first time). Both
# lines belong together — the policy keeps Compose off Docker Hub:
#SERVER_IMAGE=trinitycore-3.4.3:local
#SERVER_PULL_POLICY=never

# Forked this repo? Your Actions workflow pushes to
# ghcr.io/<your-user>/<your-fork-lowercased>; point SERVER_IMAGE there once
# your first build is green. A fork's fresh package starts out PRIVATE, so
# flip it (Packages → the package → package settings → Change visibility →
# Public) or every host has to `docker login ghcr.io`. Until you do, a fork
# still works: it pulls this repo's public image.

# Upgrading from an older copy of this file? If .env pins
# SERVER_IMAGE=trinitycore-3.4.3:local, delete that line (and the policy line)
# — otherwise every first boot compiles the core instead of pulling it.

# Automatically download the official TrinityCore TDB 3.4.3 world DB on
# first boot (true/false). Set false if you import your own world dump
# through ./import/world/.
AUTO_DOWNLOAD_DB=true

# Where the world/hotfixes full dumps come from on first boot. Empty means the
# current official release for the source revision compiled in this image
# (xHashii/WyrmrestCore DB.2608). Set one or both only if the author publishes
# a newer release or you want a specific snapshot.
#WORLD_DB_URL=https://github.com/xHashii/WyrmrestCore/releases/download/DB.2608/world_full_2026_08_10.sql
#HOTFIXES_DB_URL=https://github.com/xHashii/WyrmrestCore/releases/download/DB.2608/hotfixes_full_2026_08_10.sql
# Legacy fallback: a single .7z holding auth/characters/world/hotfixes. Setting
# DB_URL makes the entrypoint use this instead of WORLD_DB_URL/HOTFIXES_DB_URL.
#DB_URL=https://github.com/lineagedr/3.4.3_Source/releases/download/databases/Databases.7z

# Which TrinityCore source gets compiled into the image. Only needed if the
# repo above ever moves or you want to build your own fork. (The CI workflow
# pins SOURCE_SHA on its own — you don't have to set it here.)
#SOURCE_REPO=https://github.com/xHashii/3.4.3_Source.git
#SOURCE_BRANCH=main
#UBUNTU_VERSION=24.04

# Address advertised to the game client by BOTH auth.realmlist and bnetserver's
# REST/SRP login response. Use a bare host/IP (no http:// and no port).
#   client on this Docker host only: 127.0.0.1
#   clients elsewhere on the LAN:    the Docker host's LAN IP
#   internet clients:                public IP / DNS name (and forward TCP
#                                    1119, 8081, 8085 and 8086)
REALM_NAME=TrinityCore 3.4.3
REALM_ADDRESS=127.0.0.1

# Advanced routing overrides. Leave blank for normal Docker bridge networking:
# NAT hides client subnets from the containers, so advertising REALM_ADDRESS to
# every client is the reliable default. These are mainly useful with host
# networking or unusual routed setups.
#REALM_LOCAL_ADDRESS=192.168.1.10
#LOGIN_REST_EXTERNAL_ADDRESS=wow.example.com
#LOGIN_REST_LOCAL_ADDRESS=192.168.1.10

# Timezone for container logs (the CI date tag is UTC)
TZ=Europe/Kiev
